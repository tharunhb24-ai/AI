import math
import random

# Initialize the board
board = [' ' for _ in range(9)]

def print_board(curr_board):
    print('-----------')
    print(f' {curr_board[0]} | {curr_board[1]} | {curr_board[2]} ')
    print('-----------')
    print(f' {curr_board[3]} | {curr_board[4]} | {curr_board[5]} ')
    print('-----------')
    print(f' {curr_board[6]} | {curr_board[7]} | {curr_board[8]} ')
    print('-----------')

def is_winner(curr_board, letter):
    win_conditions = [
        [0, 1, 2], [3, 4, 5], [6, 7, 8],  # Rows
        [0, 3, 6], [1, 4, 7], [2, 5, 8],  # Columns
        [0, 4, 8], [2, 4, 6]             # Diagonals
    ]
    return any(all(curr_board[i] == letter for i in cond) for cond in win_conditions)

def get_empty_cells(curr_board):
    return [i for i, spot in enumerate(curr_board) if spot == ' ']

def is_board_full(curr_board):
    return ' ' not in curr_board

# Minimax algorithm for unbeatable AI
def minimax(curr_board, is_maximizing):
    if is_winner(curr_board, 'O'):
        return 1
    if is_winner(curr_board, 'X'):
        return -1
    if is_board_full(curr_board):
        return 0

    if is_maximizing:
        max_eval = -math.inf
        for cell in get_empty_cells(curr_board):
            curr_board[cell] = 'O'
            eval_score = minimax(curr_board, False)
            curr_board[cell] = ' '
            max_eval = max(max_eval, eval_score)
        return max_eval
    else:
        min_eval = math.inf
        for cell in get_empty_cells(curr_board):
            curr_board[cell] = 'X'
            eval_score = minimax(curr_board, True)
            curr_board[cell] = ' '
            min_eval = min(min_eval, eval_score)
        return min_eval

def ai_move(curr_board):
    best_score = -math.inf
    move = None
    for cell in get_empty_cells(curr_board):
        curr_board[cell] = 'O'
        score = minimax(curr_board, False)
        curr_board[cell] = ' '
        if score > best_score:
            best_score = score
            move = cell
    curr_board[move] = 'O'

def player_move(curr_board):
    while True:
        try:
            spot = int(input("Choose a position (0-8): "))
            if curr_board[spot] == ' ':
                curr_board[spot] = 'X'
                break
            else:
                print("That space is occupied! Try again.")
        except (ValueError, IndexError):
            print("Invalid input. Enter a number between 0 and 8.")

# Main Game Loop
def play_game():
    print("Welcome to Tic-Tac-Toe: Human (X) vs AI (O)")
    print_board(board)

    while not is_board_full(board):
        # Human turn
        player_move(board)
        print_board(board)
        if is_winner(board, 'X'):
            print("Congratulations! You won!")
            break
        if is_board_full(board):
            print("It's a tie!")
            break

        # AI turn
        print("AI is making a move...")
        ai_move(board)
        print_board(board)
        if is_winner(board, 'O'):
            print("AI wins! Better luck next time.")
            break
        if is_board_full(board):
            print("It's a tie!")
            break

if __name__ == "__main__":
    play_game()
